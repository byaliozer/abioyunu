    "icon": "./assets/images/icon.png",
    "scheme": "abi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.busegame.abi",
      "infoPlist": {
        "GADApplicationIdentifier": "ca-app-pub-9873123247401502~8867540882",
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork" },
